{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-f0-9]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "operation": {
      "enum": [
        "import-prices",
        "import-cftc",
        "import-records",
        "fetch-fred",
        "fetch-alpha-gold",
        "fetch-fred-reviewed",
        "fetch-worldbank-gold",
        "fetch-cftc-gold",
        "import-release-evidence",
        "import-release-values"
      ],
      "title": "Operation",
      "type": "string"
    },
    "application_version": {
      "minLength": 1,
      "title": "Application Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "status": {
      "enum": [
        "running",
        "succeeded",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "parameters": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Parameters",
      "type": "object"
    },
    "raw_sha256": {
      "default": [],
      "items": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "title": "Raw Sha256",
      "type": "array"
    },
    "record_ids": {
      "default": [],
      "items": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "title": "Record Ids",
      "type": "array"
    },
    "inserted_records": {
      "default": 0,
      "minimum": 0,
      "title": "Inserted Records",
      "type": "integer"
    },
    "failure_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Type"
    }
  },
  "required": [
    "run_id",
    "operation",
    "application_version",
    "started_at",
    "status",
    "parameters"
  ],
  "title": "AcquisitionRun",
  "type": "object"
}
