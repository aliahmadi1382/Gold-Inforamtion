{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "MacroEntry": {
      "additionalProperties": false,
      "properties": {
        "series_id": {
          "minLength": 1,
          "title": "Series Id",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "frequency": {
          "minLength": 1,
          "title": "Frequency",
          "type": "string"
        },
        "status": {
          "enum": [
            "available",
            "missing",
            "missing_value",
            "stale"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "reference_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference At"
        },
        "available_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Available At"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "availability_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Availability Basis"
        },
        "reference_age_days": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Age Days"
        },
        "max_age_days": {
          "title": "Max Age Days",
          "type": "number"
        },
        "record_id": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Id"
        }
      },
      "required": [
        "series_id",
        "unit",
        "frequency",
        "status",
        "max_age_days"
      ],
      "title": "MacroEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "mode": {
      "enum": [
        "system",
        "source"
      ],
      "title": "Mode",
      "type": "string"
    },
    "vintage": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Vintage"
    },
    "status": {
      "enum": [
        "available",
        "incomplete"
      ],
      "title": "Status",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/MacroEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "note": {
      "default": "Reference dates are period labels, not release times. Historical vintages retain retrieval-time availability unless a release timestamp is independently verified. Latest nulls remain missing; no backward fill or trading signal is produced.",
      "title": "Note",
      "type": "string"
    }
  },
  "required": [
    "as_of",
    "mode",
    "vintage",
    "status",
    "entries"
  ],
  "title": "MacroContext",
  "type": "object"
}
