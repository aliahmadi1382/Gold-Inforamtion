{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ReportFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^(?:details/)?[a-z][a-z0-9-]*(?:\\.fa)?\\.(?:json|md)$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "title": "ReportFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "software_version": {
      "title": "Software Version",
      "type": "string"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "report_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Report Fingerprint",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/ReportFile"
      },
      "title": "Files",
      "type": "array"
    }
  },
  "required": [
    "software_version",
    "as_of",
    "report_fingerprint",
    "files"
  ],
  "title": "ReportManifestV1",
  "type": "object"
}
