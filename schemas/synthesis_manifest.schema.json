{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "SynthesisFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "enum": [
            "synthesis.json",
            "synthesis.fa.md",
            "inputs/research.json"
          ],
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "title": "SynthesisFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Fingerprint",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/SynthesisFile"
      },
      "title": "Files",
      "type": "array"
    }
  },
  "required": [
    "fingerprint",
    "files"
  ],
  "title": "SynthesisManifest",
  "type": "object"
}
